# Environment passed to every emulator container (consumer.py / docker_spawn.py read ./env/.env)
# and to the Pi-hole container. One KEY=VALUE per line; no spaces around '='.
# init_env.sh copies this file to env/.env and fills in the secrets.

# Time zone of the containers (e.g. Europe/Berlin, America/New_York)
TZ=UTC

# Pi-hole web-interface / API password
WEBPASSWORD=CHANGE_THIS_SECRET

# WebRTC ICE configuration used by the emulator's remote-display stack.
# Must match the user/password/realm in coturn/turnserver.conf.
TURN='printf {"iceServers":[{"credential":"CHANGE_THIS_TURN_PASSWORD","urls":["turn:turn.example.org"],"username":"turnuser"}]}'
