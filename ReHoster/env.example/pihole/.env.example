# Pi-hole container (docker-compose: env_file ./env/pihole/.env)
TZ=UTC
# Web-interface / API password (Pi-hole v6 name; WEBPASSWORD is the v5 name)
FTLCONF_webserver_api_password=CHANGE_THIS_SECRET
WEBPASSWORD=CHANGE_THIS_SECRET
# Answer queries from the emulator network
FTLCONF_dns_listeningMode=all
